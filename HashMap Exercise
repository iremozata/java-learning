import java.util.HashMap;

public class Main {
    public static void main(String[] args) {
        HashMap<String,String> dictionary = new HashMap<String, String>();
        dictionary.put("purple", "púrpura");
        dictionary.put("green", "verde");
        dictionary.put("pink", "rosa");
        dictionary.put("blue", "azul");
        System.out.println(dictionary.size());
        for (String item : dictionary.keySet()){
            System.out.println("English-"+item+" Spanish-"+dictionary.get(item));
        }
        System.out.println(dictionary.get("green"));
    }
}
