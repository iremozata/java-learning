public class Main {
    public static void main(String[] args) {
        char grade = 'D';
        switch (grade) {
            case 'A':
                System.out.println("Perfect, passed.");
                break;
            case 'B':
            case 'C':
                System.out.println("Good job, passed.");
                break;
            case 'D':
                System.out.println("I believe you can do better, passed.");
                break;
            case 'F':
                System.out.println("See you later, failed.");
                break;
            default:
                System.out.println("Invalid grade entry");
        }
    }
}
