public class Main {
    public static void main(String[] args) {
        int[] numbers = new int[]{3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5, 8};
        int find = 10;
        boolean isThere = false;

        for (int number : numbers) {
            if (number == find) {
                isThere = true;
                break;
            }
        }

        if (isThere) {
            System.out.println(find + " exists in the series.");
        } else {
            System.out.println(find + " does not exist in the series.");
        }
    }
}
